# Python
__pycache__/
*.pyc

# Virtual environment (see requirements.txt for how it's created on rpi502)
.venv/

# Calibration/runtime state: specific to whatever servos are physically
# plugged in right now, and servo_positions.json changes on every move —
# neither belongs in version control.
calibration_data/

# Named pipe created locally by the GPIO library, not a real file
.lgd-nfy0

# Generated print-ready calibration targets (derived from generate_targets.py,
# not source — regenerate rather than version).
camera_calibration/print_targets/

# Raw calibration photos and their computed result: specific to this exact
# physical camera rig (positions, focus, the printed board's real size) —
# re-capture/re-run rather than version.
camera_calibration/calibration_captures/
